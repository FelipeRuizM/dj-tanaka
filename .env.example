# Copy this file to .env.local and fill in real values.

# Firebase (RTDB + Auth) — get these from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# UIDs of the admin accounts allowed to write shows, comma-separated
# (e.g. TANAKA_UID,OTHER_UID). Find them in Firebase Console →
# Authentication → Users after creating the email/password accounts.
VITE_ADMIN_UID=

# Tanaka's Instagram handle (no @).
VITE_INSTAGRAM_HANDLE=itistanaka

# Behold.so feed ID (optional — placeholder grid renders without it).
VITE_BEHOLD_FEED_ID=
