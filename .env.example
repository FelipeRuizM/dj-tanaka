# Copy this file to .env.local and fill in real values.

# Firebase (RTDB + Auth) — get these from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The UID of the admin account that's allowed to write shows.
# Find it in Firebase Console → Authentication → Users after creating the
# email/password account.
VITE_ADMIN_UID=

# Tanaka's Instagram handle (no @).
VITE_INSTAGRAM_HANDLE=dj.tanaka_

# Behold.so feed ID (optional — placeholder grid renders without it).
VITE_BEHOLD_FEED_ID=
